# =====================================================================
# Configuración de conexión a la base de datos EXTERNA (PostgreSQL).
# Copia este archivo a ".env" (mismo folder) y coloca los datos reales
# del servidor de base de datos que estés usando (uno propio, uno del
# laboratorio, un contenedor Docker separado, o un servicio en la nube
# como Supabase / Railway / Neon / ElephantSQL).
#
# El archivo ".env" NO se sube al repositorio (ver .gitignore) porque
# contiene credenciales.
# =====================================================================

NORMALAB_DB_HOST=localhost
NORMALAB_DB_PORT=5432
NORMALAB_DB_NAME=normalab
NORMALAB_DB_USER=normalab_app
NORMALAB_DB_PASSWORD=cambia_esta_clave

# Si tu proveedor exige SSL (la mayoría de servicios en la nube lo exigen)
# cambia esto a "true".
NORMALAB_DB_SSL=false

# Puerto en el que corre este backend (Express).
PORT=3000

# Orígenes permitidos para peticiones desde el Frontend (CORS).
# En desarrollo con Expo web normalmente es http://localhost:8081
CORS_ORIGIN=*
